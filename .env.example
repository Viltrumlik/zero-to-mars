# Noldan Marsgacha — server sozlamalari.
# Nusxa oling:  cp .env.example .env   va qiymatlarni to'ldiring.
# Izohlar alohida qatorda bo'lsin (qiymat yonida # yozmang).

# ---------------------------------------------------------------- Telegram ---

# @BotFather /newbot bergan token. Productionda MAJBURIY.
BOT_TOKEN=

# Bot username, @ belgisisiz (masalan: NoldanMarsgachaBot). Taklif havolalari uchun.
BOT_USERNAME=

# Ixtiyoriy: @BotFather /newapp da berilgan Mini App short name (masalan: play).
# To'ldirilsa, taklif havolasi https://t.me/<BOT_USERNAME>/<APP_SHORT_NAME>?startapp=ref_<id> bo'ladi
# va o'yin to'g'ridan-to'g'ri ochiladi. Bo'sh bo'lsa: https://t.me/<BOT_USERNAME>?start=ref_<id>
APP_SHORT_NAME=

# O'yinning ochiq HTTPS manzili (DOMAIN bilan bir xil). Bot tugmasi va menyu shu manzilni ochadi.
WEBAPP_URL=https://mars.example.uz/

# ------------------------------------------------------------------ Server ---

# Domen nomi (https:// siz). Caddy shu domen uchun SSL sertifikatni avtomatik oladi.
DOMAIN=mars.example.uz

# HTTP port (Docker ichida doim 3000; docker-compose.yml buni o'zi belgilaydi).
PORT=3000

# SQLite baza fayli. Docker'da /app/data/game.db (= serverdagi ./data/game.db).
DB_PATH=./data/game.db

# Qurilgan 3D client papkasi (npm run build natijasi).
STATIC_DIR=client/dist

# Telegram initData necha soniya amal qiladi (86400 = 1 kun).
AUTH_MAX_AGE_SEC=86400

# FAQAT lokal ishlab chiqish uchun: 1 bo'lsa "Authorization: dev <id>:<ism>" qabul qilinadi.
# Productionda doim 0 (NODE_ENV=production bo'lsa baribir o'chiriladi).
DEV_AUTH=0

# Log darajasi: fatal | error | warn | info | debug (production uchun info).
LOG_LEVEL=info
