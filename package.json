{
  "name": "zero-to-mars",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Noldan Marsgacha: 3D founder life simulator (Telegram WebApp)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --config client/vite.config.ts",
    "dev:server": "DEV_AUTH=1 node --watch server/src/index.ts",
    "build": "vite build --config client/vite.config.ts",
    "start": "node server/src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "balance": "node scripts/balance.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.10",
    "fastify": "^5.12.8",
    "grammy": "^1.46.0"
  },
  "devDependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "postprocessing": "^6.39.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "zustand": "^5.1.0"
  }
}
